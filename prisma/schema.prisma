datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Branch {
  id             String            @id @default(uuid())
  name           String
  location       String
  users          User[]
  inventory      BranchInventory[]
  sales          Sale[]
  transfersFrom  StockTransfer[]   @relation("SendingBranch")
  transfersTo    StockTransfer[]   @relation("ReceivingBranch")
  purchaseOrders PurchaseOrder[]
}

model User {
  id       String  @id @default(uuid())
  name     String
  email    String  @unique
  role     String  // SYS_ADMIN, OPS_DIRECTOR, PURCHASING, BRANCH_MANAGER, INVENTORY_STAFF, CASHIER, FINANCE
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])
}

model Product {
  id            String              @id @default(uuid())
  name          String
  categoryId    String
  category      Category            @relation(fields: [categoryId], references: [id])
  unitPrice     Float
  unitOfMeasure String
  isActive      Boolean             @default(true)
  inventory     BranchInventory[]
  saleItems     SaleItem[]
  poItems       PurchaseOrderItem[]
  transfers     StockTransfer[]
}

model Category {
  id       String    @id @default(uuid())
  name     String
  products Product[]
}

model BranchInventory {
  id                String  @id @default(uuid())
  branchId          String
  productId         String
  quantity          Int     @default(0)
  lowStockThreshold Int     @default(10)
  branch            Branch  @relation(fields: [branchId], references: [id])
  product           Product @relation(fields: [productId], references: [id])

  @@unique([branchId, productId])
}

model Sale {
  id             String     @id @default(uuid())
  branchId       String
  cashierId      String
  customerName   String?
  customerPhone  String?
  discountAmount Float      @default(0.0)
  totalAmount    Float
  paymentMethod  String     @default("Cash")
  createdAt      DateTime   @default(now())
  branch         Branch     @relation(fields: [branchId], references: [id])
  items          SaleItem[]
}

model SaleItem {
  id        String  @id @default(uuid())
  saleId    String
  productId String
  quantity  Int
  unitPrice Float
  subtotal  Float
  sale      Sale    @relation(fields: [saleId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

model Supplier {
  id             String          @id @default(uuid())
  companyName    String
  contactPerson  String
  phone          String
  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id         String              @id @default(uuid())
  supplierId String
  branchId   String
  status     String              @default("OPEN") // OPEN, PARTIAL, FULFILLED
  createdAt  DateTime            @default(now())
  supplier   Supplier            @relation(fields: [supplierId], references: [id])
  branch     Branch              @relation(fields: [branchId], references: [id])
  items      PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  productId       String
  orderedQty      Int
  receivedQty     Int           @default(0)
  unitCost        Float
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id])
}

model StockTransfer {
  id                String   @id @default(uuid())
  sendingBranchId   String
  receivingBranchId String
  productId         String
  quantity          Int
  status            String   @default("PENDING") // PENDING, COMPLETED, CANCELLED
  createdAt         DateTime @default(now())
  sendingBranch     Branch   @relation("SendingBranch", fields: [sendingBranchId], references: [id])
  receivingBranch   Branch   @relation("ReceivingBranch", fields: [receivingBranchId], references: [id])
  product           Product  @relation(fields: [productId], references: [id])
}
